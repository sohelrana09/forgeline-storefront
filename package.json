{
  "name": "forgeline-storefront",
  "version": "2.3.0",
  "private": true,
  "description": "An open-source B2B and B2C storefront for commercetools, built with Next.js 16.",
  "license": "MIT",
  "homepage": "https://github.com/sohelrana09/forgeline-storefront#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohelrana09/forgeline-storefront.git"
  },
  "bugs": "https://github.com/sohelrana09/forgeline-storefront/issues",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "setup": "tsx --conditions=react-server scripts/setup.ts",
    "ct:hello": "tsx --conditions=react-server --env-file=.env scripts/hello.ts",
    "ct:create-bu": "tsx --conditions=react-server --env-file=.env scripts/create-business-unit.ts",
    "typecheck": "tsc --noEmit",
    "ct:query": "tsx --conditions=react-server --env-file=.env scripts/ct-query.ts",
    "ct:contexts": "tsx --conditions=react-server --env-file=.env scripts/ct-buying-contexts.ts",
    "ct:seed-buyers": "tsx --conditions=react-server --env-file=.env --env-file=.env.demo scripts/seed-demo-buyers.ts",
    "ct:seed-associates": "tsx --conditions=react-server --env-file=.env --env-file=.env.demo scripts/seed-demo-buyers.ts --all-roles",
    "ct:quote-respond": "tsx --conditions=react-server --env-file=.env scripts/quote-respond.ts",
    "ct:catalog-subscription": "tsx --conditions=react-server --env-file=.env scripts/catalog-subscription.ts",
    "ct:order-subscription": "tsx --conditions=react-server --env-file=.env scripts/order-subscription.ts",
    "ct:seed-approval-rules": "tsx --conditions=react-server --env-file=.env scripts/seed-approval-rules.ts",
    "ct:tier-prices": "tsx --conditions=react-server --env-file=.env scripts/tier-prices.ts",
    "ct:nz-trade": "tsx --conditions=react-server --env-file=.env --env-file-if-exists=.env.demo scripts/nz-trade.ts",
    "ct:customer-group-prices": "tsx --conditions=react-server --env-file=.env scripts/customer-group-prices.ts",
    "ct:urls": "tsx --conditions=react-server --env-file=.env scripts/urls.ts",
    "ct:sanity-content": "tsx --conditions=react-server --env-file=.env scripts/sanity-content.ts",
    "ct:sanity-webhook": "tsx --conditions=react-server --env-file=.env scripts/sanity-webhook.ts",
    "ct:order-approval-type": "tsx --conditions=react-server --env-file=.env scripts/order-approval-type.mts",
    "ct:seed-list-permissions": "tsx --conditions=react-server --env-file=.env scripts/seed-shopping-list-permissions.ts",
    "ct:seed-cart-review-permissions": "tsx --conditions=react-server --env-file=.env scripts/seed-cart-review-permissions.ts",
    "ct:demo-reset": "tsx --conditions=react-server --env-file=.env scripts/demo-reset.mts",
    "ct:price": "tsx --conditions=react-server --env-file=.env scripts/standalone-price.ts",
    "ct:revalidate": "tsx --conditions=react-server --env-file=.env scripts/revalidate.ts",
    "ct:punchout": "tsx --conditions=react-server --env-file=.env scripts/punchout.ts",
    "ct:product-selections": "tsx --conditions=react-server --env-file=.env scripts/product-selections.ts",
    "ct:review-states": "tsx --conditions=react-server --env-file=.env scripts/review-states.ts",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@commercetools/checkout-browser-sdk": "^1.7.5",
    "@commercetools/platform-sdk": "^9.8.0",
    "@commercetools/ts-client": "^5.1.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.4.10",
    "@upstash/redis": "^1.41.0",
    "botid": "^1.5.11",
    "next": "^16.4.5",
    "next-sanity": "^13.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.22.0",
    "saxes": "6.0.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0",
    "undici": "^8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "undici": "$undici"
    },
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.9.1"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  }
}
