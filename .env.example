# Copy to .env and fill in from Merchant Center → Settings → Developer settings → API client
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_AUTH_URL=https://auth.us-east-2.aws.commercetools.com
CTP_API_URL=https://api.us-east-2.aws.commercetools.com
CTP_SCOPES=manage_project:your-project-key
# Before going live, give the shop its own API client with only the scopes it needs (docs/api-clients.md): put that
# one in CTP_CLIENT_* (and empty CTP_SCOPES), and move the admin client here. Only the scripts (npm run setup, ct:*)
# use it; never set these in the hosting.
# CTP_ADMIN_CLIENT_ID=
# CTP_ADMIN_CLIENT_SECRET=
# API client used for customer logins (password flow). Per store it must hold manage_my_profile, manage_my_orders,
# manage_my_quote_requests, manage_my_quotes, manage_my_shopping_lists and create_anonymous_token; login narrows
# each customer token to just the "my" scopes, so admin endpoints answer 403.
CTP_STOREFRONT_CLIENT_ID=
CTP_STOREFRONT_CLIENT_SECRET=
# Public address of the storefront, used in email links (password reset, email verification). Never taken from the
# request's Host header, so a forged header can't point a reset link at another site.
SITE_URL=http://localhost:3000
# Let search engines index the catalog (noindex everywhere and an empty sitemap otherwise). Off for sandboxes and demos.
SITE_INDEXABLE=false
# Lets the Sanity webhook, jobs and queues refresh the cached guest pages (POST /api/revalidate). At least 32 random
# characters, e.g. `openssl rand -hex 32`.
REVALIDATE_SECRET=
# Lets commercetools call the company price extension (POST /api/price-extension, docs/nz-trade-pricing.md). At least 32
# random characters, e.g. `openssl rand -hex 32`. Only needed with `npm run ct:nz-trade -- --extension`.
PRICE_EXTENSION_SECRET=
# Lets the commercetools order Subscription's queue call POST /api/order-events (npm run ct:order-subscription). At least
# 32 random characters, e.g. `openssl rand -hex 32`. Without it, orders are still processed by the server actions and
# the sweep.
ORDER_EVENTS_SECRET=
# Lets the scheduler call GET /api/cron/order-sweep (Vercel Cron sends it as a Bearer token). At least 32 random characters.
CRON_SECRET=
# Order numbers look like <prefix>-<year>-000123. 1 to 8 capital letters or digits; default ORD.
ORDER_NUMBER_PREFIX=
# Encrypts the sign-in and guest cookies. At least 32 random characters, e.g. `openssl rand -hex 32`. To rotate it,
# move the old value to SESSION_SECRET_PREVIOUS for 30 days (the cookies' lifetime), so nobody is signed out. Required
# in production: the server refuses to start without it. In local development the key comes from CTP_CLIENT_SECRET.
SESSION_SECRET=
# SESSION_SECRET_PREVIOUS=
# Keeps cookies sealed with the old CTP_CLIENT_SECRET key open after SESSION_SECRET is set. Only for a migration: whoever
# holds the API secret can forge sessions while it is on.
# SESSION_ALLOW_LEGACY=true
# Set to "false" to skip the check of new passwords against known breaches (api.pwnedpasswords.com, only the first 5
# characters of the password's SHA-1 are sent).
# PASSWORD_BREACH_CHECK=false
# Shared rate limits and locks across server instances. Needed in production: without it each instance counts on its
# own, and the instrumentation logs config_degraded at start. On Vercel: Storage →
# Upstash (Marketplace) sets these for you; KV_REST_API_URL / KV_REST_API_TOKEN work too.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Email delivery through Resend (resend.com: verify your domain, then create an API key with "Sending access").
# Without a key, development prints each email to the server log and production logs an error instead of sending.
# RESEND_API_KEY=
# MAIL_FROM="Ironline Supply <shop@your-domain.com>"
# commercetools Checkout (card payments for consumers and guests): the key of the Payment Only Application in
# Merchant Center → Checkout → Applications. The admin client above must be able to get manage_sessions.
CTP_CHECKOUT_APPLICATION_KEY=ironline-payment
# Payment methods for consumers and guests, one switch each ("true" = offered; anything else = hidden). Business
# buyers always order on invoice. With all three off, consumers and guests can't pay.
# Card through commercetools Checkout (a card integration on the Payment Only application).
B2C_CARD_PAYMENTS=false
# PayPal through commercetools Checkout (a PayPal integration on the same application). Also allows PayPal's hosts in
# the Content-Security-Policy.
CHECKOUT_PAYPAL=false
# Cards through the Braintree connector instead of the sample one: allows Braintree's and Cardinal's (3-D Secure) hosts
# in the Content-Security-Policy. Offers nothing on its own: B2C_CARD_PAYMENTS still switches cards on.
CHECKOUT_BRAINTREE=false
# Optional speed-up for the card and PayPal forms: comma-separated URLs whose hosts the payment step connects to while
# the page loads. A URL ending in .js is also fetched ahead of time. Use the card connector's enabler script, its
# service URL and the payment provider's API (Connect shows the first two on the deployment), for example
# https://assets-<id>.us-east-2.aws.preview.commercetools.app/connector-enabler.es.js,https://service-<id>.us-east-2.aws.preview.commercetools.app,https://payments.sandbox.braintree-api.com
CHECKOUT_PRELOAD=
# Bank transfer: the order is placed directly and paid later (set BANK_TRANSFER_EXPIRY_DAYS too).
B2C_BANK_TRANSFER=true
# ---- Optional B2B and B2C features (docs/features/), all off unless switched on ----
# Cost centre, project code, requested delivery date and order note at business checkout. Run
# `npm run ct:order-approval-type -- --yes` first: it adds the fields to the cart/order Type.
# PROCUREMENT_FIELDS=true
# Monthly or quarterly budgets per business unit and buyer, edited at /account/company/budgets.
# SPENDING_LIMITS=true
# Recurring orders (native commercetools Recurring Orders) from a past order or a purchase list. The runtime client
# needs manage_recurring_orders and view_recurrence_policies; the daily cron /api/cron/recurring-orders sends the
# reminders (CRON_SECRET).
# RECURRING_ORDERS=true
# Buyers send their cart to a colleague who may order and handle others' carts (/account/shared-carts). Needs the
# share fields on the order Type (ct:order-approval-type) and such a role (ct:seed-cart-review-permissions).
# SHARED_CARTS=true
# PunchOut from the buyer's procurement system (cXML /api/punchout/setup, SAP OCI /api/punchout/oci). Connections are
# set up with ct:punchout, which reads the shared secret from PUNCHOUT_SHARED_SECRET (only when you run it).
# PUNCHOUT=true
# Product reviews by verified buyers, approved in Merchant Center. Needs the review states (ct:review-states) and the
# manage_reviews and view_states scopes.
# REVIEWS=true
# "Email me when it's back" on out-of-stock products, sent by the daily /api/cron/stock-alerts (CRON_SECRET).
# STOCK_ALERTS=true
# Wallet buttons (Apple Pay, Google Pay, PayPal) on the cart through Checkout's express flow. Needs B2C_CARD_PAYMENTS or
# CHECKOUT_PAYPAL and an express payment integration on the Checkout Application.
# CHECKOUT_EXPRESS=true
# Storefront language, one per deployment (docs/features/i18n.md): en-US (default), en-GB, de-DE, es-ES, fr-FR (UI text),
# or it-IT, nl-NL, pt-PT (product data only, English UI).
# Product and category names, URLs, dates and money follow it; read at build time.
# NEXT_PUBLIC_SITE_LOCALE=de-DE
# Analytics (docs/features/analytics-datalayer.md): a Google Tag Manager container id. Adds a consent banner; the
# container loads only after the visitor accepts. Read at build time.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Tracing (docs/features/quality-gates.md): OpenTelemetry spans for every request and commercetools call, sent to an
# OTLP/HTTP endpoint (Grafana Tempo, Honeycomb, Datadog, New Relic, an OpenTelemetry Collector). Off without an endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...
# OTEL_SERVICE_NAME=forgeline-storefront
# OTEL_TRACES_SAMPLER_ARG=0.1
# Search and category listings: "product-search" uses the commercetools Product Search API (activate it in Merchant
# Center first; docs/features/search-scaling.md) for search, suggestions and category filters, counts and sorting;
# anything else, or a failing call, uses the built-in in-memory index (fine for small catalogs).
# CATALOG_SEARCH=product-search
# Sanity (content pages and the blog; the Studio is embedded at /studio). Without a project id there are no content
# pages and the blog is off. Create the project in sanity.io/manage with a public
# "production" dataset, and add http://localhost:3000 and the live domain as CORS origins with credentials allowed.
NEXT_SANITY_PROJECT_ID=
NEXT_SANITY_DATASET=production
# Viewer token: draft preview in the Studio's Presentation tool (server only).
SANITY_API_READ_TOKEN=
# Editor token: only for `npm run ct:sanity-content` (the demo blog); not needed on Vercel.
SANITY_API_WRITE_TOKEN=
# A Studio on its own domain (`npx sanity deploy`, docs/sanity-studio.md), e.g. https://forgeline.sanity.studio: /studio
# then redirects there, and that origin may preview the pages and use the Studio's pickers. Empty = embedded at /studio.
# STUDIO_URL=
# How long a bank-transfer order stays open unpaid before the sweep cancels it, gives the stock back and tells the buyer.
# Unset: never (the stock stays taken until someone cancels the order).
# BANK_TRANSFER_EXPIRY_DAYS=7
# A guest's bank-transfer order takes stock before any money arrives, so its size is capped (default 100 pieces).
# UNPAID_ORDER_MAX_QUANTITY=100
# Set to "false" when an ERP owns the stock: orders cancelled here then don't add it back.
# RESTOCK_ON_CANCEL=false
# Seller details on invoices and bank-transfer instructions. Demo values without them; with SITE_INDEXABLE=true the
# server refuses to start until the legal fields are set. SELLER_ADDRESS lines are separated by |.
# SELLER_NAME=
# SELLER_ADDRESS="1 Example Street|12345 City|Country"
# SELLER_VAT_ID=
# SELLER_EMAIL=
# SELLER_BANK_NAME=
# SELLER_IBAN=
# SELLER_BIC=
# SELLER_PAYMENT_TERMS_DAYS=30
# Set to "false" when no proxy in front of the app sets the client's address (rate limits then ignore the address).
# TRUSTED_PROXY=false
# Verifies Sanity's webhook signature (the webhook's "Secret" field) on POST /api/revalidate.
# SANITY_WEBHOOK_SECRET=
# "true" (at build and run time) once the publish webhook works: content is then cached for an hour instead of a minute.
# SANITY_WEBHOOK_CONFIGURED=true
# Where browsers report Content-Security-Policy violations.
# CSP_REPORT_URI=
# "true" (at build time) loads images straight from their hosts instead of through /_next/image. For when the host's image
# optimizer is out of quota, as on Vercel Hobby (it answers 402 and images break). Pages get heavier.
# IMAGES_UNOPTIMIZED=true
# Your project's folder on the commercetools image CDN (product images uploaded in Merchant Center): copy the start of any
# uploaded image's URL, up to and including the folder id. Only that folder goes through the image optimizer. Read at
# build time. Unset: the demo project's folder.
# NEXT_PUBLIC_PRODUCT_IMAGES_URL=https://images.us-east-2.aws.commercetools.com/<folder id>/

# Purchase order to cart (docs/features/ai-po-to-cart.md): signed-in buyers paste a purchase order or upload its PDF on
# /quick-order, and Claude (claude-opus-5-5, with server-side fallbacks) reads its lines into the quick-order box for
# them to check. Needs both. The key is server-only; uploads are never stored. Each read is a paid API request
# (limited to 10 per customer and 30 per address per 15 minutes). Read at build time too (raises the Server Action
# body limit to 6 MB for PDFs).
# AI_PO_TO_CART=true
# ANTHROPIC_API_KEY=

# Demo personas (docs/features/demo-personas.md): "Try as Buyer / Approver / Admin" on /login, a demo banner, and the
# nightly reset (/api/cron/demo-reset, CRON_SECRET) of the personas' carts, quotes, approvals, lists, budgets and
# recurring orders. Only for a project and company that exist for the demo. DEMO_PASSWORD is the personas' password
# (the one setup writes to the demo file); server-only, never sent to the browser. Without DEMO_MODE nothing shows.
# DEMO_MODE=true
# DEMO_PASSWORD=
# Personas (default: the sample data's LiftTech Soluciones people).
# DEMO_BUYER_EMAIL=sofia-lopez@ltsl.com
# DEMO_APPROVER_EMAIL=carlos-garcia@ltsl.com
# DEMO_ADMIN_EMAIL=oliver-smith@ltsl.com
