# Content app environment. Copy to .env (git-ignored) and adjust. mc-scripts loads .env automatically.

# Build tooling (eslint.config.js, jest.test.config.js)
ENABLE_NEW_JSX_TRANSFORM="true"
FAST_REFRESH="true"

# Merchant Center region of the project: ctwara is in AWS us-east-2, which Merchant Center calls "aws-us".
CLOUD_IDENTIFIER="aws-us"

# Optional. If set, must equal entryPointUriPath in src/constants.ts (the path registered in Merchant Center).
# ENTRY_POINT_URI_PATH=""

# Production build only (npm run build). On commercetools Connect these come from connect.yaml / the deployment.
# CUSTOM_APPLICATION_ID="your-custom-application-id"
# APPLICATION_URL="https://your-content-app.example.com"
# STOREFRONT_URL="https://your-storefront.example.com"
